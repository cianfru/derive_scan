# Recorder (public data only, no keys needed)
DERIVE_SNAPSHOT_SOURCES=v2_mainnet        # comma list: v2_mainnet, v3_testnet, v3_mainnet
DERIVE_UNDERLYINGS=BTC,ETH
DERIVE_SNAPSHOT_INTERVAL_SEC=900
DERIVE_CHAIN_EVERY_SEC=3600               # raw chain (gzip) kept hourly
DERIVE_CHAIN_RETENTION_DAYS=365           # 0 keeps forever
DERIVE_RECORDER=on                        # off: serve the API only
DATA_DIR=data
PORT=8000

