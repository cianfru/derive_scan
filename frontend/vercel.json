{
  "rewrites": [
    {
      "source": "/control",
      "destination": "/control.html"
    },
    {
      "source": "/control/(.*)",
      "destination": "/control.html"
    },
    {
      "source": "/((?!brand/|assets/|fonts/|coins/|favicon|site\\.webmanifest|robots\\.txt|control).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-Bj6ipgLkBmZCG6Rasyeyph2qAm+MARcvrq8pKIR/WjA='; style-src 'self' 'unsafe-inline'; connect-src 'self' https://raw.githubusercontent.com https://li.quest https://ethereum-rpc.publicnode.com https://base-rpc.publicnode.com https://arbitrum-one-rpc.publicnode.com https://rpc.hyperliquid.xyz https://api.derive.xyz https://testnet.api.derive.xyz wss://api.derive.xyz wss://testnet.api.derive.xyz; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/control(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
